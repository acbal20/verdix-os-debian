#!/bin/sh
# VERDIX OS: inyeccion en caliente del rootfs live (sin reconstruir el squashfs).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0;;
esac

[ -d "${rootmnt}" ] || exit 0
[ -d /verdix/rootfs ] || exit 0

echo "[verdix] inyectando aplicacion y servicios..."

# 1) Assets y configuracion de Verdix (opt/verdix, lightdm, helpers, service)
cp -a /verdix/rootfs/. "${rootmnt}/" 2>/dev/null || true

# 2) Usuario verdix (UID 1001; live-config reserva el 1000 para 'user')
if ! grep -q '^verdix:' "${rootmnt}/etc/passwd" 2>/dev/null; then
  echo 'verdix:x:1001:1001:Verdix OS:/home/verdix:/bin/bash' >> "${rootmnt}/etc/passwd"
  echo 'verdix:$6$verdixos$4nSc8XdoAaJrSZZeydqn8Rc/Id5.Zh.tIZZx8wLNLZVYC8d5XASjtqVlfGDZUJw8jyUl:20431:0:99999:7:::' >> "${rootmnt}/etc/shadow"
  echo 'verdix:x:1001:' >> "${rootmnt}/etc/group"
  mkdir -p "${rootmnt}/home/verdix"
  cp -a /etc/skel/. "${rootmnt}/home/verdix/" 2>/dev/null || true
  chown -R 1001:1001 "${rootmnt}/home/verdix" 2>/dev/null || true
fi

# 3) Pertenencia a grupos de hardware y sudo
for g in sudo audio video plugdev; do
  if grep -q "^${g}:" "${rootmnt}/etc/group" 2>/dev/null; then
    grep -q "^${g}:.*verdix" "${rootmnt}/etc/group" || \
      sed -i "s/^\\(${g}:[^:]*:[0-9]*:\\)\\(.*\\)$/\\1verdix,\\2/" "${rootmnt}/etc/group"
  fi
done

# 4) sudo sin contrasena (live OS)
mkdir -p "${rootmnt}/etc/sudoers.d"
printf 'verdix ALL=(ALL) NOPASSWD:ALL\n' > "${rootmnt}/etc/sudoers.d/verdix"
chmod 0440 "${rootmnt}/etc/sudoers.d/verdix" 2>/dev/null || true

# 5) Habilitar servicio web de Verdix
mkdir -p "${rootmnt}/etc/systemd/system/multi-user.target.wants" \
         "${rootmnt}/etc/systemd/system/graphical.target.wants"
for t in multi-user graphical; do
  ln -sf /etc/systemd/system/verdix.service \
    "${rootmnt}/etc/systemd/system/${t}.target.wants/verdix.service" 2>/dev/null || true
done

# 6) Identidad del sistema
printf 'verdix\n' > "${rootmnt}/etc/hostname"

# 7) Autologin root en consola serie (pruebas QEMU y recuperacion)
mkdir -p "${rootmnt}/etc/systemd/system/serial-getty@ttyS0.service.d"
cat > "${rootmnt}/etc/systemd/system/serial-getty@ttyS0.service.d/override.conf" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I 115200
EOF

# 8) Autostart del escritorio React en modo kiosk
mkdir -p "${rootmnt}/home/verdix/.config/autostart"
cat > "${rootmnt}/home/verdix/.config/autostart/verdix-desktop.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=VERDIX Desktop
Comment=Escritorio VERDIX basado en React
Exec=firefox-esr --kiosk --no-remote http://127.0.0.1:8099/desktop/
X-GNOME-Autostart-enabled=true
NoDisplay=false
EOF
chown -R 1001:1001 "${rootmnt}/home/verdix/.config" 2>/dev/null || true

echo "[verdix] inyeccion completada"
